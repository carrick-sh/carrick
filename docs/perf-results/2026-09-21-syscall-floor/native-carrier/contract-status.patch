--- before/conformance-contracts/contracts/native-synchronous-syscall.toml
+++ after/conformance-contracts/contracts/native-synchronous-syscall.toml
@@ -8,8 +8,8 @@
 rationale = "The native adapter must execute real guest instructions through current unified-kernel policy and completion paths. Matching errno output alone does not prove executable permission, frame ownership, signal delivery, TLS, or translation revocation. The existing host callback gateway is not a binding for this contract."
 
 [bindings.unresolved]
-vm_free = "Required: authenticated instruction fetch with executable permission, wrong-MM and stale-lease rejection, and generation-bound translation publication. CurrentMmMemory is a marker, not an execution capability. Existing current_mm tests cover lease authentication only."
-embed_structural = "A bounded non-product executor now runs real ELF instructions against the public kernel and emits partial observations; it is not an embed binding. Unified-carrier memory authority, COW, foreign writes, guest signals/cancellation and scheduling remain unproved. Require actual register/TLS behavior, two-MM isolation, revocation and measured dispatch/completion/transition counts. See docs/perf-results/2026-09-21-syscall-floor/native-slice."
+vm_free = "Authenticated instruction fetch and a mutation-scoped carrier native-data grant now have focused tests for exact execution/MM authority, permissions, revisions and COW backing. They do not provide concurrent execution admission, revocation or generation-bound translation publication. CurrentMmMemory remains a marker. No VM-free execution binding is registered. See docs/perf-results/2026-09-21-syscall-floor/native-carrier."
+embed_structural = "A bounded non-product executor now runs real ELF instructions against the public kernel and emits partial observations; it is not an embed binding. Carrier COW and pinned data access are now composed under existing exact-MM mutation exclusion in a separate fixture; the ELF executor still uses private backing. Concurrent carrier execution, foreign-write invalidation, guest signals/cancellation and scheduling remain unproved. Require actual register/TLS behavior, two-MM isolation, revocation and measured dispatch/completion/transition counts. See docs/perf-results/2026-09-21-syscall-floor/native-slice."
 embed_timing = "No native adapter timing accepted. Same-ELF diagnostic native/HVF/Linux measurements exist. Native scalar lowering reduced the private-backing memory control from 151.92 ns to 2.12 ns (1.53x Linux), but is not a current-carrier memory grant. Compute, COW, JIT, signals and full current-runtime controls remain acceptance requirements. See docs/perf-results/2026-09-21-syscall-floor/native-memory."
 docker = "Exact errno control matches native ARM64 Docker at all scales; versioned observation emission and remaining register/TLS/signal/memory fixtures are not yet bound. Evidence: docs/perf-results/2026-09-21-syscall-floor/dsr-guest-contract."
 
