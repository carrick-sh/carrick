+            _owner_pin: owner_pin,
+            ptr: dst_ptr,
+            snapshot: requested,
+            start: va,
+            len,
+            mapping: cow.mapping(),
+            frame: cow.frame(),
+            owner_generation: cow.owner_generation(),
+        })
