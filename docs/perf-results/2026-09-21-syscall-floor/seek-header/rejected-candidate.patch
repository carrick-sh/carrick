+schema_version = 1
+id = "kernel.fs.seek-header-input"
+title = "Seek authority metadata is read once without allocating input buffers"
+guest_surfaces = ["syscall:lseek"]
+semantic_authority = ["man 2 lseek", "Carrick identity-page seek authority ABI"]
+fixture = "unit:seek_header_one_read_without_input_allocation"
+scale_points = [1, 8, 32, 128]
+rationale = "The fixed identity-page header fits in one stack buffer. Guest read permission and translation remain in the existing CurrentMmMemory API; host offset, active/inactive gate, descriptor matching, negative offsets and unavailable metadata retain their existing behavior. The measured allocations belong only to guest metadata input, not the full syscall."
+[bindings]
+vm_free = "carrick-kernel::dispatch::fs::tests::seek_header"
+embed = "carrick-conformance-next::write_seek_lease::write_seek_lease_alias_preserves_shared_offset"
+docker = "probe:writeseek"
+ecosystem = ["ltp:inotify09"]
+[bindings.unresolved]
+embed_structural = "The signed path preserves semantics; production guest-memory allocation counts are not emitted by this fixture."
+embed_timing = "Full inotify09 and fixed-work controls use independent uninstrumented runs, not an embed timing observation."
+[[structural_budgets]]
+kind = "exact"
+metric = "host_heap_allocations"
+value = 0
+layers = ["vm-free"]
+rationale = "The measured guest-memory backend counts actual Vec creation for this fixed input. Its read_into implementation copies directly into the caller buffer."
+[[structural_budgets]]
+kind = "affine"
+metric = "guest_memory_read_bytes"
+base = 0
+per_unit = 20
+layers = ["vm-free"]
+rationale = "Each request reads at most the 20-byte gate/fd/offset header, including its four padding bytes. The binding also asserts exactly one backend read per request."
