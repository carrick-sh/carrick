@@ -0,0 +1,32 @@
+schema_version = 1
+id = "kernel.syscall.context-retention"
+title = "Syscall service borrows its exact entry context"
+guest_surfaces = ["kernel:syscall-completion", "syscall:inotify_rm_watch"]
+semantic_authority = ["Carrick exact task and resource generation contract", "Linux inotify_rm_watch EBADF semantics", "Carrick exactly-once syscall observer contract"]
+fixture = "unit:syscall-context-retention"
+scale_points = [1, 8, 32, 128]
+rationale = "Capture one fresh context per syscall. Service and redispatch borrow it; the completion token retains one exact snapshot for its ownership handoff. No context is cached across calls or recaptured from a newer resource generation during redispatch."
+
+[bindings]
+vm_free = "carrick-runtime::vcpu_loop::exec::tests::syscall_context_retention_contract"
+
+[bindings.unresolved]
+docker = "Fresh native ARM64 Linux full inotify09 comparison pending for this candidate; VM-free fixture asserts the documented invalid-fd result."
+embed_structural = "Full signed inotify09 and watch-lifecycle semantics qualify workload behavior, but do not directly measure context-retain counts. Focused signed validation pending for this candidate."
+embed_timing = "Uninstrumented full inotify09 paired comparison is required before retaining this optimization."
+
+[[structural_budgets]]
+kind = "affine"
+metric = "kernel_context_retains"
+base = 0
+per_unit = 1
+layers = ["vm-free"]
+rationale = "One owned exact snapshot per completion token; initial dispatch and any redispatch add no copies."
+
+[[structural_budgets]]
+kind = "affine"
+metric = "kernel_dispatches"
+base = 0
+per_unit = 1
+layers = ["vm-free"]
+rationale = "Each logical syscall is prepared and observed once even when its handler is redispatched."
