+#[test]
+fn syscall_write_destinations_preserve_bytes_permissions_and_cow() {
+    let _lock = common::guest_lock();
+    let directory = tempfile::TempDir::new().unwrap();
+    std::fs::write(
+        directory.path().join("data"),
+        b"0123456789abcdef".repeat(2048),
