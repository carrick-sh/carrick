+        {
+            let _active = prepared.activate(&scope).unwrap();
+        }
+        drop(scope);
+        drop(executor);
+        drop(mutator);
+        assert_eq!(census.participant_count_for_probe(), 0);
+        fixture
+            .child
+            .thread()
+            .yield_from_executor(successor)
+            .unwrap();
+    }
