+                                            readable: true,
+                                            writable: true,
+                                            executable: false,
+                                            kernel_visible: true,
+                                        },
+                                    );
+                                }
+                            }
+                            6 => fixture.dispatch_mm.set_foreign_cow_vma_access_for_test(
+                                carrick_kernel::kernel::VmaAccess {
+                                    readable: true,
+                                    writable: true,
+                                    executable: true,
+                                    kernel_visible: true,
+                                },
+                            ),
+                            _ => unreachable!(),
