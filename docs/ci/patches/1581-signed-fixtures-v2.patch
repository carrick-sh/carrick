@@ -0,0 +1,48 @@
+name: PR signed fixtures
+on:
+  pull_request:
+    types: [opened, synchronize, reopened]
+permissions:
+  contents: read
+jobs:
+  fixtures:
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 60
+    env:
+      FIXTURE_SHA: ${{ github.event.pull_request.head.sha }}
+      CARRICK_SCCACHE: "0"
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          ref: ${{ github.event.pull_request.head.sha }}
+          persist-credentials: false
+      - name: Verify native ARM Linux publisher
+        run: |
+          test "$(uname -s)" = Linux
+          test "$(uname -m)" = aarch64
+
+      - name: Test fixture relay transport and fallback
+        run: scripts/ci/test-fixture-relay.sh
+
+      - name: Install pinned Rust toolchain and guest targets
+        run: rustup show active-toolchain
+
+      - name: Install just
+        uses: taiki-e/install-action@e407f7bafb71fd004bc5c2da3032e5470cbb6ef0
+        with:
+          tool: just
+
+      - name: Install per-user compiler cache
+        uses: taiki-e/install-action@e407f7bafb71fd004bc5c2da3032e5470cbb6ef0 # v2
+        with:
+          tool: sccache@0.18.0
+
+      - name: Publish exact-SHA fixture bundle
+        run: just fixtures-publish "$FIXTURE_SHA"
+
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: signed-fixtures-${{ github.event.pull_request.head.sha }}
+          path: target/fixtures/published/${{ github.event.pull_request.head.sha }}/*.tar.gz
+          if-no-files-found: error
+          compression-level: 0
