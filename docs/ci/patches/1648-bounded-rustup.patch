--- a/.github/workflows/kernel-runtime.yml
+++ b/.github/workflows/kernel-runtime.yml
@@ -155,12 +155,32 @@ jobs:
       # cloudmac provides a root-owned, read-only rustup toolchain (pinned by
       # rust-toolchain.toml, with sccache) and a runner-private CARGO_HOME;
       # jobs never install or update toolchains there (docs/ci/mac-hvf-runner.md).
-      - name: Verify the read-only toolchain
+      - name: Verify the read-only toolchain (infrastructure)
+        shell: bash
         run: |
+          set -euo pipefail
           test -n "$RUSTUP_HOME"
           test ! -w "$RUSTUP_HOME"
-          rustup show active-toolchain
           command -v sccache
+          verify_toolchain() {
+            rustup show active-toolchain
+          }
+          export -f verify_toolchain
+          if ! python3 - <<'PYTHON'
+          import os, signal, subprocess, sys
+          child = subprocess.Popen(["bash", "-c", "verify_toolchain"], start_new_session=True)
+          try:
+              sys.exit(child.wait(timeout=600))
+          except subprocess.TimeoutExpired:
+              os.killpg(child.pid, signal.SIGKILL)
+              child.wait()
+              sys.exit(75)
+          PYTHON
+          then
+            echo '::error title=Infrastructure::Rust toolchain verification failed; tests did not run'
+            exit 75
+          fi
+          echo 'RUSTUP_AUTO_INSTALL=0' >> "$GITHUB_ENV"
 
