--- a/.github/workflows/signed-gate.yml
+++ b/.github/workflows/signed-gate.yml
@@ -55,8 +55,54 @@
           path: ${{ runner.temp }}/request/
           if-no-files-found: error
 
+  signed-fixtures:
+    needs: authorize
+    runs-on: ubuntu-24.04-arm
+    timeout-minutes: 60
+    permissions:
+      contents: read
+    env:
+      FIXTURE_SHA: ${{ needs.authorize.outputs.sha }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ needs.authorize.outputs.sha }}
+          persist-credentials: false
+
+      - name: Verify native ARM Linux publisher
+        run: |
+          test "$(uname -s)" = Linux
+          test "$(uname -m)" = aarch64
+
+      - name: Test fixture relay transport and fallback
+        run: scripts/ci/test-fixture-relay.sh
+
+      - name: Install pinned Rust toolchain and guest targets
+        run: rustup show active-toolchain
+
+      - name: Install just
+        uses: taiki-e/install-action@v2
+        with:
+          tool: just
+
+      - name: Install per-user compiler cache
+        uses: taiki-e/install-action@e407f7bafb71fd004bc5c2da3032e5470cbb6ef0 # v2
+        with:
+          tool: sccache@0.18.0
+
+      - name: Publish exact-SHA fixture bundle
+        run: just fixtures-publish "$FIXTURE_SHA"
+
+      - name: Upload exact-SHA fixture bundle
+        uses: actions/upload-artifact@v4
+        with:
+          name: signed-fixtures-${{ needs.authorize.outputs.sha }}-${{ github.run_attempt }}
+          path: target/fixtures/published/${{ needs.authorize.outputs.sha }}/*.tar.gz
+          if-no-files-found: error
+          compression-level: 0
+
   gate:
-    needs: authorize
+    needs: [authorize, signed-fixtures]
     runs-on: [self-hosted, macOS, ARM64, carrick-signed-gate]
     timeout-minutes: 240
     # GitHub has not assigned runner.name when it evaluates concurrency.
@@ -78,12 +124,24 @@
         with:
           name: signed-request-${{ github.run_attempt }}
           path: ${{ runner.temp }}/request
+      - uses: actions/download-artifact@v4
+        with:
+          name: signed-fixtures-${{ needs.authorize.outputs.sha }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/signed-fixtures
+      - name: Select the unique content-addressed archive
+        id: fixture
+        shell: bash
+        run: |
+          set -euo pipefail
+          shopt -s nullglob
+          bundles=("$RUNNER_TEMP"/signed-fixtures/*.tar.gz)
+          test "${#bundles[@]}" -eq 1
+          printf 'bundle=%s\n' "${bundles[0]}" >> "$GITHUB_OUTPUT"
       - name: Execute approved SHA in a fresh detached worktree
         env:
           CARRICK_RUN_ID: signed-gate-${{ github.run_id }}-${{ github.run_attempt }}
-          # Local immutable bundle path, configured separately on each Mac.
-          # No API credential is passed to candidate code.
-          CARRICK_SIGNED_FIXTURE_BUNDLE: ${{ vars.CARRICK_SIGNED_FIXTURE_BUNDLE }}
+          # Same-run artifact; no API credential is passed to candidate code.
