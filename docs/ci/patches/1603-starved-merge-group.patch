+      # Keep the existing ci-results verdict authoritative (#1603).
+      - name: Download xtask for cancellation diagnostics
+        continue-on-error: true
+        if: github.event_name == 'merge_group' && contains(toJSON(needs), 'cancelled')
+        uses: actions/download-artifact@v4
+        with:
