#!/bin/sh
# Carrick pre-push hook: refuse to push clippy-unfriendly code.
#
# This mirrors the CI clippy gate (`cargo clippy --workspace --all-targets
# --keep-going -- -D warnings`, the no-panic gate). It runs at push — not
# per-commit — because it recompiles the workspace and can take a while after
# edits. `--keep-going` reports clippy errors across ALL crates in one pass
# instead of stopping at the first failing crate, so you see the whole list.
# Install with `just install-hooks` (sets core.hooksPath to .githooks).
#
# NOTE: CI tracks the latest stable Rust (dtolnay/rust-toolchain@stable),
# so a freshly released stable can flag lints your local toolchain doesn't.
# Keep local in sync with `rustup update stable`.
#
# `git push --no-verify` only with owner approval recorded on the PR (AGENTS.md).

set -eu

saw_ref=0
non_claim_ref=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "${local_ref}${local_sha}${remote_ref}${remote_sha}" ]; then
        continue
    fi
    saw_ref=1
    case "$remote_ref" in
        refs/claims/?*) ;;
        *) non_claim_ref=1 ;;
    esac
done

if [ "$saw_ref" -eq 1 ] && [ "$non_claim_ref" -eq 0 ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v just >/dev/null 2>&1; then
    clippy="just clippy"
else
    clippy="cargo clippy --workspace --all-targets --keep-going -- -D warnings"
fi

printf 'pre-push: running clippy gate (%s)\n' "$clippy"
if ! $clippy; then
    printf '\npre-push: clippy gate failed. Fix the warnings above before pushing.\n' >&2
    exit 1
fi
