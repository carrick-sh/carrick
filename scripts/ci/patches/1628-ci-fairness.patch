diff --git a/.github/workflows/ci-fairness.yml b/.github/workflows/ci-fairness.yml
new file mode 100644
index 000000000..9ef61f634
--- /dev/null
+++ b/.github/workflows/ci-fairness.yml
@@ -0,0 +1,44 @@
+name: Hosted CI fairness
+
+on:
+  # Trusted base context, including fork closures; never check out PR code.
+  pull_request_target:
+    types: [closed]
+  workflow_run:
+    workflows: [Hosted CI]
+    types: [in_progress]
+
+# Deliberately no concurrency group: neither a closure nor another run may
+# evict an observer. This workflow never occupies carrick-macos-ci capacity.
+permissions:
+  contents: read
+  actions: write
+  issues: read
+  pull-requests: read
+
+jobs:
+  observe:
+    if: github.event_name == 'pull_request_target' || github.event.workflow_run.event == 'pull_request'
+    runs-on: ubuntu-latest
+    timeout-minutes: 320
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          # Both events execute trusted default-branch code exclusively.
+          ref: ${{ github.event.repository.default_branch }}
+          persist-credentials: false
+      - name: Build trusted observer
+        run: cargo build --locked -p carrick-xtask
+      - name: Release runs that cannot land
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          EVENT: ${{ github.event_name }}
+          PR: ${{ github.event.pull_request.number }}
+          RUN: ${{ github.event.workflow_run.id }}
+        run: |
+          if [ "$EVENT" = pull_request_target ]; then
+            target/debug/carrick-xtask ci-fairness closed "$REPO" "$PR"
+          else
+            target/debug/carrick-xtask ci-fairness watch "$REPO" "$RUN"
+          fi
