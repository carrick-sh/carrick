diff --git a/.github/workflows/ci-fairness.yml b/.github/workflows/ci-fairness.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/ci-fairness.yml
@@ -0,0 +1,47 @@
+name: Hosted CI fairness
+
+on:
+  # Trusted base context, including fork closures; never check out PR code.
+  pull_request_target:
+    types: [closed]
+  # workflow_job is webhook-only. A trusted relay forwards completed failures.
+  repository_dispatch:
+    types: [ci-job-failed]
+
+# Dedupe each run/job event without dropping another failed job event.
+# Closure events use a separate PR key so they cannot suppress job failures.
+concurrency:
+  group: ci-fairness-${{ github.event_name }}-${{ github.event.client_payload.workflow_job.run_id || github.event.pull_request.number }}-${{ github.event.client_payload.workflow_job.id || 'closed' }}
+  cancel-in-progress: false
+permissions:
+  contents: read
+  actions: write
+  issues: read
+  pull-requests: read
+
+jobs:
+  observe:
+    if: github.event_name == 'pull_request_target' || (github.event.client_payload.action == 'completed' && github.event.client_payload.workflow_job.conclusion == 'failure')
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          # Both events execute trusted default-branch code exclusively.
+          ref: ${{ github.event.repository.default_branch }}
+          persist-credentials: false
+      - name: Build trusted observer
+        run: cargo build --locked -p carrick-xtask
+      - name: Release runs that cannot land
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          EVENT: ${{ github.event_name }}
+          PR: ${{ github.event.pull_request.number }}
+          EVENT_PATH: ${{ github.event_path }}
+        run: |
+          if [ "$EVENT" = pull_request_target ]; then
+            target/debug/carrick-xtask ci-fairness closed "$REPO" "$PR"
+          else
+            target/debug/carrick-xtask ci-fairness completed "$REPO" "$EVENT_PATH"
+          fi
